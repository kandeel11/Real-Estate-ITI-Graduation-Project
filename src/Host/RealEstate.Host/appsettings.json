  // S3-compatible object storage (Backblaze B2) — one bucket, folder-prefixed per
  // module (property-media/, property-documents/, leases/, maintenance/, ai-documents/).
  // Endpoint is B2's S3-compatible base URL, e.g. https://s3.us-west-002.backblazeb2.com
  // — Region is the same "us-west-002" part. Set PublicBaseUrl (a B2 "friendly URL" /
  // custom domain, bucket set to public) if property photos should render without a
  // presigned link. Private documents (leases, ownership proofs) always use presigned URLs.
  "R2": {
    "Endpoint": "Will-Be-Overridden-By-Secrets",
    "Region": "Will-Be-Overridden-By-Secrets",
    "AccessKeyId": "Will-Be-Overridden-By-Secrets",
    "SecretAccessKey": "Will-Be-Overridden-By-Secrets",
    "BucketName": "real-estate-storage",
    "PublicBaseUrl": "",
    "PresignExpiryMinutes": 60
  },
